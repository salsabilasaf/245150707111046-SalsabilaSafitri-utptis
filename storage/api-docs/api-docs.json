                "tags": [
                    "Items"
                ],
                "summary": "Tambah item baru",
                "operationId": "af37857663e6805dd367a55f374c9ee1",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "nama",
                                    "harga"
                                ],
                                "properties": {
                                    "nama": {
                                        "type": "string",
                                        "example": "Headset"
                                    },
                                    "harga": {
                                        "type": "number",
                                        "example": 250000
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
